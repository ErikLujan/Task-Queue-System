APP_NAME="Task Queue System"
ENVIRONMENT=development
DEBUG=true

# Credenciales de Redis
REDIS_PASSWORD=<una_contraseña_segura>
REDIS_URL=redis://:<la_misma_contraseña>@localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# Credenciales de la base de datos
DB_USER=<tu_usuario>
DB_PASSWORD=<una_contraseña_segura>
DB_NAME=taskqueue
DATABASE_URL=postgresql://<tu_usuario>:<tu_contraseña>@localhost:5432/taskqueue

CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_HARD_TIME_LIMIT=600

MAX_FILE_SIZE_MB=10
TMP_UPLOAD_DIR=tmp/uploads
TMP_OUTPUT_DIR=tmp/outputs

# El valor que generaste con: uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<valor_generado>
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Credenciales para el panel de Flower
FLOWER_USER=<tu_usuario>
FLOWER_PASSWORD=<una_contraseña_segura>